# ─────────────────────────────────────────────────────────────
# BOT AUTOMATIZACIONES — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env a un repositorio público.
# ─────────────────────────────────────────────────────────────

# ── Identidad del bot ─────────────────────────────────────────
BUSINESS_NAME=Automatizaciones
BOT_NAME=Asistente

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.7

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
# Necesario SOLO si usas la integración directa con la API de Meta.
# Si solo usas Chatwoot como canal, puedes dejarlo vacío.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERIFY_TOKEN=automatizaciones_verify_token
GRAPH_API_VERSION=v22.0

# ── Chatwoot ──────────────────────────────────────────────────
# URL de tu instancia de Chatwoot (sin "/" al final)
CHATWOOT_URL=https://app.chatwoot.com
# Token del Agent Bot (Chatwoot → Settings → Agent Bots → tu bot → Access Token)
CHATWOOT_BOT_TOKEN=
# Token de usuario administrador (para asignar agentes en handoff)
CHATWOOT_ADMIN_TOKEN=
# ID de la cuenta de Chatwoot (número que aparece en la URL)
CHATWOOT_ACCOUNT_ID=1
# IDs de agentes para handoff automático, separados por coma (ej: "5,12")
# Déjalo vacío si no quieres asignación automática
CHATWOOT_HANDOFF_AGENT_IDS=

# ── Base de datos SQLite ──────────────────────────────────────
DATABASE_PATH=data/chat_history.db

# ── Horario de atención ───────────────────────────────────────
BUSINESS_TIMEZONE=Europe/Madrid
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
# 0=lunes, 1=martes, 2=miércoles, 3=jueves, 4=viernes, 5=sábado, 6=domingo
BUSINESS_WEEKDAYS=0,1,2,3,4

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW=60
IP_RATE_LIMIT=30/minute

# ── Historial de conversación ─────────────────────────────────
HISTORY_LIMIT=30

# ── Prompt del sistema ────────────────────────────────────────
# Escribe aquí el prompt completo de tu bot entre comillas dobles.
# Usa \n para saltos de línea dentro del prompt si lo necesitas.
# Para prompts muy largos, edita directamente config.py.
#
# Señal de handoff para el bot: si el prompt o la IA incluye
# la palabra TRANSFERIR_AGENTE en su respuesta, se activa el
# handoff a un agente humano automáticamente.
SYSTEM_PROMPT="
Eres un asistente virtual especializado en automatizaciones con n8n y servicios digitales.

Tu función es atender consultas de clientes interesados en automatizar procesos de negocio.

INSTRUCCIONES:
- Responde siempre en español, de forma clara, profesional y cercana.
- Máximo 600 caracteres por respuesta.
- Usa *negrita* para resaltar puntos clave (formato WhatsApp).
- Para transferir a un agente humano, incluye exactamente: TRANSFERIR_AGENTE

SALUDO INICIAL:
Cuando el cliente saluda por primera vez, responde:
'👋 ¡Hola! Bienvenid@ 😊 Soy tu asistente de Automatizaciones. ¿En qué puedo ayudarte hoy?'
Solo una vez por conversación.

[COMPLETA ESTE PROMPT CON LA INFORMACIÓN REAL DE TU NEGOCIO]
"
